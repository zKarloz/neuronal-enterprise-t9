# Solo servidor; no subir credenciales reales al repositorio.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
FRONTEND_ORIGINS=http://localhost:5173,https://TU-FRONTEND.vercel.app

# Rutas fijas OAuth; sustitúyelas con tus dominios reales.
OAUTH_CALLBACK_URL=https://neuronal-enterprise-api.onrender.com/api/v1/auth/google/callback
OAUTH_FRONTEND_URL=https://TU-FRONTEND.vercel.app

# Preferida: clave secreta sb_secret_... solo en Render (nunca en Vercel).
SUPABASE_SECRET_KEY=
# Alternativa temporal si el proyecto aún usa JWT legacy service_role.
SUPABASE_SERVICE_ROLE_KEY=
DATASET_BUCKET=neurolab-datasets

# Bucket privado exclusivo para modelos .keras (crear en Supabase Storage)
MODEL_BUCKET=neurolab-models
